# Cloud Tunnel / Ngrok domain or backend host
NGROK_HOST=telesthetic-tridimensionally-margarete.ngrok-free.dev

# Backend Gateway API Base URL (Java Spring Cloud Gateway: 5001)
EXPO_PUBLIC_API_BASE_URL=https://telesthetic-tridimensionally-margarete.ngrok-free.dev

# Real-time WebSocket Base URL (ws / wss)
EXPO_PUBLIC_WS_URL=wss://telesthetic-tridimensionally-margarete.ngrok-free.dev

# Python Telemetry & Risk Socket Host / URL (serves /ws/front/{client_id})
EXPO_PUBLIC_PYTHON_WS_HOST=localhost:8000
EXPO_PUBLIC_PYTHON_WS_URL=ws://localhost:8000