# Backend WebSocket URL for Real-time Geotechnical & Kiosk Alerts (Java room-service)
VITE_WS_ALERT_URL=ws://localhost:5004/ws/alerts

# Backend REST API Base URL for Reports, Stations, Uploads, and Auth (Java Spring Cloud Gateway)
VITE_API_BASE_URL=http://localhost:5001

# Reconnection interval in milliseconds
VITE_WS_RECONNECT_INTERVAL=3000

# Enable simulation fallback when backend WebSocket is offline
VITE_ENABLE_MOCK_FALLBACK=false
